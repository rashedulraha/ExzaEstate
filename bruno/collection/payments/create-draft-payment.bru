meta {
  name: Create Draft Payment
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/collection/payments/draft
  body: json
  auth: bearer
}

auth:bearer {
  token: {{executiveToken}}
}

headers {
  Content-Type: application/json
  Idempotency-Key: {{guid}}
}

body:json {
  {
    "bookingId": "{{bookingId}}",
    "customerId": "{{customerId}}",
    "amountPaisa": "50000000",
    "paymentType": "BOOKING_MONEY",
    "paymentMethod": "BANK",
    "bankName": "Dhaka Bank Ltd",
    "bankBranch": "Gulshan",
    "accountNumber": "205-100-987654",
    "transactionReference": "TXN-2026-9988",
    "notes": "Booking money payment for Plot 101"
  }
}
