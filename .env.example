# ==============================================================================
# ExzaEstate Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your environment.
# Business & security rules: see agent/architecture.md and agent/security.md.

# ------------------------------------------------------------------------------
# 1. Application & Server Environment
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development

# HTTP listening port
PORT=3000

# Backend runtime mode: cloud | local
# In 'cloud' mode, external Redis, S3, and worker are used.
# In 'local' mode, embedded SQLite/Postgres and in-process background queues are used.
RUNTIME_MODE=cloud

# CORS allowed origins (comma-separated strings or regex)
CORS_ORIGIN=http://localhost:5173,tauri://localhost

# Structured logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 18 with RLS)
# ------------------------------------------------------------------------------
# Application database URL (least-privilege runtime role: exza_app, NOBYPASSRLS)
DATABASE_URL=postgresql://exza_app:exza_app_secret@localhost:5432/exzaestate?schema=public

# Migrator database URL (table owner/DDL role: exza_migrator, used only during deployment migrations)
MIGRATOR_DATABASE_URL=postgresql://exza_migrator:exza_migrator_secret@localhost:5432/exzaestate?schema=public

# ------------------------------------------------------------------------------
# 3. Cache & Background Job Queue (Redis 8)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Secrets (Argon2id + JWT)
# ------------------------------------------------------------------------------
# Access token signing secret (minimum 32 characters, rotate periodically)
JWT_ACCESS_SECRET=exza_jwt_access_secret_must_be_at_least_32_characters_long

# Refresh token signing secret (minimum 32 characters, rotate periodically)
JWT_REFRESH_SECRET=exza_jwt_refresh_secret_must_be_at_least_32_characters_long

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 5. Object Storage (S3-compatible / MinIO)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=exzaestate-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 6. OpenAPI / Swagger Documentation
# ------------------------------------------------------------------------------
# Swagger UI is mounted at /api/docs.
# In production (NODE_ENV=production), it is strictly DISABLED unless SWAGGER_ENABLED=true
# and basic authentication credentials (SWAGGER_USER and SWAGGER_PASSWORD) are set.
SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme_in_production

# ------------------------------------------------------------------------------
# 7. Email / SMTP (Mailpit local development)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@exzaestate.com

# ------------------------------------------------------------------------------
# 8. Super Admin & Initial Enterprise License Configuration
# ------------------------------------------------------------------------------
SUPER_ADMIN_NAME="Exzazon Team"
SUPER_ADMIN_EMAIL="exzazon.bd@gmail.com"
SUPER_ADMIN_SECONDARY_EMAIL="rashedulraha.bd@gmail.com"
SUPER_ADMIN_PASSWORD="lDMBXtn9t3nOTa32@2026!"
INITIAL_LICENSE_KEY="EXZA-ENTERPRISE-2026-ABCD-EF01-9999"

