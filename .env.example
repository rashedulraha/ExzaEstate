# ==============================================================================
# ExzaEstate Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the project root.
# 2. Never commit `.env` containing real production secrets to version control.
# 3. For Production Cloud deployments, generate 64-character hex strings for keys:
#      openssl rand -hex 32
#
# Reference documents:
# - agent/architecture.md (Stack, dual-mode runtime, database roles)
# - agent/security.md (OWASP hardening, least privilege, RLS, Argon2id)
# ==============================================================================

# ==============================================================================
# SECTION 1: CORE APPLICATION & RUNTIME MODE
# ==============================================================================

# Runtime environment: 'development' | 'production' | 'test'
# [LOCAL DEV]: development
# [PRODUCTION]: production
NODE_ENV=development

# Server HTTP port
# [LOCAL DEV / PRODUCTION]: 3000 (or internal container port)
PORT=3000

# Architecture Runtime Mode: 'cloud' | 'local'
# - 'cloud': Multi-tenant cluster with external PostgreSQL 18, Redis 8, S3 object storage
# - 'local': Single-tenant desktop standalone sidecar mode
RUNTIME_MODE=cloud

# Frontend & Desktop Client API Base URL
# [LOCAL DEV]: http://localhost:3000
# [PRODUCTION]: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:3000

# Initial Enterprise License Key
# Used for initial tenant onboarding or enterprise activation validation
VITE_INITIAL_LICENSE_KEY="EXZA-ENTERPRISE-2026-ABCD-EF01-9999"

# CORS Allowed Origins
# Comma-separated list of allowed web/desktop origins.
# [LOCAL DEV]: http://localhost:5173,tauri://localhost
# [PRODUCTION]: Strict list, e.g. https://app.yourdomain.com,tauri://localhost
# CRITICAL: Wildcard '*' is strictly rejected by validation in production!
CORS_ORIGIN=http://localhost:5173,tauri://localhost

# Structured Logger Level: fatal | error | warn | info | debug | trace
# [LOCAL DEV]: debug or info
# [PRODUCTION]: info or warn
LOG_LEVEL=info

# ==============================================================================
# SECTION 2: DATABASE ROLES & CONNECTIONS (PostgreSQL 18 + RLS)
# ==============================================================================
# ExzaEstate uses PostgreSQL Row-Level Security (RLS) with 3 isolated roles:
# 1. DATABASE_URL: Least-privilege runtime role 'exza_app' (NOBYPASSRLS).
# 2. MIGRATOR_DATABASE_URL: DDL owner role 'exza_migrator' (used only for migrations).
# 3. SYSTEM_DATABASE_URL: Platform/cross-tenant maintenance role 'exza_system' (BYPASSRLS).

# [LOCAL DEV]:
DATABASE_URL=postgresql://exza_app:exza_app_secret@localhost:5432/exzaestate?schema=public
MIGRATOR_DATABASE_URL=postgresql://exza_migrator:exza_migrator_secret@localhost:5432/exzaestate?schema=public
SYSTEM_DATABASE_URL=postgresql://exza_system:exza_system_secret@localhost:5432/exzaestate?schema=public

# [PRODUCTION]:
# Generate strong, distinct passwords for each role in PostgreSQL.
# In production, default passwords like 'exza_app_secret' will fail boot validation.
# DATABASE_URL=postgresql://exza_app:<STRONG_PASSWORD>@db.prod.internal:5432/exzaestate?schema=public&sslmode=require
# MIGRATOR_DATABASE_URL=postgresql://exza_migrator:<STRONG_PASSWORD>@db.prod.internal:5432/exzaestate?schema=public&sslmode=require
# SYSTEM_DATABASE_URL=postgresql://exza_system:<STRONG_PASSWORD>@db.prod.internal:5432/exzaestate?schema=public&sslmode=require

# ==============================================================================
# SECTION 3: CACHE & ASYNC QUEUES (Redis 8 + BullMQ)
# ==============================================================================
# Required when RUNTIME_MODE=cloud. In local standalone, an in-process queue is used.
# [LOCAL DEV]: redis://localhost:6379
# [PRODUCTION]: rediss://:STRONG_REDIS_PASSWORD@redis.prod.internal:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# SECTION 4: AUTHENTICATION & JWT CRYPTOGRAPHIC SECRETS
# ==============================================================================
# In production, generate separate 256-bit keys using:
#   openssl rand -hex 32
#
# RULES:
# 1. Minimum 32 characters each.
# 2. JWT_ACCESS_SECRET and JWT_REFRESH_SECRET MUST BE DIFFERENT strings.
# 3. Placeholder strings containing 'change_this' are rejected in production.

# [LOCAL DEV]:
JWT_ACCESS_SECRET=exza_jwt_access_secret_must_be_at_least_32_characters_long
JWT_REFRESH_SECRET=exza_jwt_refresh_secret_must_be_at_least_32_characters_long

# [PRODUCTION]:
# JWT_ACCESS_SECRET=<64-char-hex-generated-via-openssl>
# JWT_REFRESH_SECRET=<different-64-char-hex-generated-via-openssl>

# Token Expiry Durations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ==============================================================================
# SECTION 5: OBJECT STORAGE (S3-Compatible / AWS S3 / MinIO / Cloudflare R2)
# ==============================================================================
# [LOCAL DEV (Docker MinIO)]:
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=exzaestate-documents
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_FORCE_PATH_STYLE=true

# [PRODUCTION (AWS S3 or Cloudflare R2)]:
# In production, default 'minioadmin' credentials will fail boot validation.
# STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# STORAGE_REGION=ap-southeast-1
# STORAGE_BUCKET=exzaestate-prod-documents
# STORAGE_ACCESS_KEY=<IAM_OR_R2_ACCESS_KEY_ID>
# STORAGE_SECRET_KEY=<IAM_OR_R2_SECRET_ACCESS_KEY>
# STORAGE_FORCE_PATH_STYLE=false

# ==============================================================================
# SECTION 6: API DOCUMENTATION / SWAGGER UI
# ==============================================================================
# Mounted at /api/docs.
# In production, SWAGGER_ENABLED defaults to false.
# If set to true in production, SWAGGER_USER and a strong SWAGGER_PASSWORD are required.
# [LOCAL DEV]:
SWAGGER_ENABLED=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=changeme_in_production

# [PRODUCTION]:
# SWAGGER_ENABLED=false
# If explicitly enabled in production:
# SWAGGER_ENABLED=true
# SWAGGER_USER=exza_api_admin
# SWAGGER_PASSWORD=<STRONG_RANDOM_PASSWORD>

# ==============================================================================
# SECTION 7: EMAIL & NOTIFICATIONS (SMTP)
# ==============================================================================
# [LOCAL DEV (Mailpit)]:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@exzaestate.com

# [PRODUCTION (AWS SES / SendGrid / Postmark)]:
# SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=<SES_SMTP_USERNAME>
# SMTP_PASSWORD=<SES_SMTP_PASSWORD>
# SMTP_FROM="ExzaEstate Platform <no-reply@yourdomain.com>"

# ==============================================================================
# SECTION 8: PLATFORM SUPER ADMIN (Initial Platform Onboarding)
# ==============================================================================
# Used only during initial database provisioning to seed the root platform super admin.
SUPER_ADMIN_NAME="Exzazon Team"
SUPER_ADMIN_EMAIL="exzazon.bd@gmail.com"
SUPER_ADMIN_SECONDARY_EMAIL="rashedulraha.bd@gmail.com"
# In production, set a strong, non-default master password:
SUPER_ADMIN_PASSWORD="ChangeMe_AdminPassword_Secure2026!"
INITIAL_LICENSE_KEY="EXZA-ENTERPRISE-2026-ABCD-EF01-9999"

# ==============================================================================
# SECTION 9: LOCAL STANDALONE / DESKTOP SIDECAR SECURITY
# ==============================================================================
# When running backend as a desktop sidecar (RUNTIME_MODE=local),
# this shared secret authenticates requests between Tauri desktop shell and local backend.
# LOCAL_API_SECRET=<generated_secret_string>
