// Commission & Broker models (Phase A8.3)
// PRD MOD-COMMISSION, FLOW-14, AT-36; accounting-rules.md §3.8

model Broker {
  id                String             @id @default(uuid(7)) @db.Uuid
  companyId         String             @map("company_id") @db.Uuid
  brokerNumber      String             @map("broker_number") @db.VarChar(64)
  name              String             @db.VarChar(255)
  phone             String             @db.VarChar(64)
  email             String?            @db.VarChar(255)
  nid               String?            @db.VarChar(64)
  tin               String?            @db.VarChar(64)

  bankName          String?            @map("bank_name") @db.VarChar(128)
  bankBranch        String?            @map("bank_branch") @db.VarChar(128)
  bankAccountNumber String?            @map("bank_account_number") @db.VarChar(512) // FieldCrypto encrypted
  routingNumber     String?            @map("routing_number") @db.VarChar(64)

  isActive          Boolean            @default(true) @map("is_active")
  totalEarnedPaisa  BigInt             @default(0) @map("total_earned_paisa") @db.BigInt
  totalPaidPaisa    BigInt             @default(0) @map("total_paid_paisa") @db.BigInt
  receivablePaisa   BigInt             @default(0) @map("receivable_paisa") @db.BigInt

  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?          @map("deleted_at") @db.Timestamptz

  commissions       CommissionRecord[]

  @@unique([companyId, brokerNumber])
  @@index([companyId])
  @@index([companyId, isActive])
  @@map("brokers")
}

model CommissionRule {
  id               String    @id @default(uuid(7)) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  name             String    @db.VarChar(128)
  projectId        String?   @map("project_id") @db.Uuid
  calculationType  String    @default("PERCENT_NET_PRICE") @map("calculation_type") @db.VarChar(32) // PERCENT_NET_PRICE, FIXED_AMOUNT, PERCENT_COLLECTED
  percentage       Decimal?  @db.Decimal(5, 2)
  fixedAmountPaisa BigInt?   @map("fixed_amount_paisa") @db.BigInt
  triggerEvent     String    @default("ON_CONFIRMED") @map("trigger_event") @db.VarChar(32) // ON_CONFIRMED, ON_AGREEMENT, ON_COLLECTION_PCT
  isActive         Boolean   @default(true) @map("is_active")

  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  @@index([companyId])
  @@index([companyId, projectId])
  @@map("commission_rules")
}

model CommissionRecord {
  id                       String    @id @default(uuid(7)) @db.Uuid
  companyId                String    @map("company_id") @db.Uuid
  commissionNumber         String    @map("commission_number") @db.VarChar(64)
  brokerId                 String    @map("broker_id") @db.Uuid
  bookingId                String    @map("booking_id") @db.Uuid
  projectId                String?   @map("project_id") @db.Uuid
  ruleId                   String?   @map("rule_id") @db.Uuid
  amountPaisa              BigInt    @map("amount_paisa") @db.BigInt

  status                   String    @default("EARNED") @db.VarChar(32) // EARNED, APPROVED, PAID, REVERSED
  earnedAt                 DateTime  @default(now()) @map("earned_at") @db.Timestamptz
  approvedAt               DateTime? @map("approved_at") @db.Timestamptz
  paidAt                   DateTime? @map("paid_at") @db.Timestamptz
  reversedAt               DateTime? @map("reversed_at") @db.Timestamptz

  paymentMethod            String?   @map("payment_method") @db.VarChar(32)
  bankAccountId            String?   @map("bank_account_id") @db.Uuid
  bankAccountCode          String?   @map("bank_account_code") @db.VarChar(32)
  reference                String?   @db.VarChar(128)

  approvalJournalId        String?   @map("approval_journal_id") @db.Uuid
  paymentJournalId         String?   @map("payment_journal_id") @db.Uuid
  reversalJournalId        String?   @map("reversal_journal_id") @db.Uuid
  clawbackReceivableCreated Boolean   @default(false) @map("clawback_receivable_created")
  notes                    String?   @db.Text

  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt                DateTime? @map("deleted_at") @db.Timestamptz

  broker                   Broker    @relation(fields: [brokerId], references: [id])

  @@unique([companyId, commissionNumber])
  @@index([companyId])
  @@index([companyId, brokerId])
  @@index([companyId, bookingId])
  @@index([companyId, status])
  @@map("commission_records")
}
