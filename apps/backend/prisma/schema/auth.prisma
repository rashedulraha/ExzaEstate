// Auth and Session models (Task A0.8 & A0.9)

model User {
  id                     String    @id @default(uuid(7)) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  email                  String    @unique @db.VarChar(255)
  passwordHash           String    @map("password_hash") @db.VarChar(255)
  fullName               String    @map("full_name") @db.VarChar(255)
  phone                  String?   @db.VarChar(32)
  status                 String    @default("ACTIVE") @db.VarChar(32)
  mustChangePassword     Boolean   @default(false) @map("must_change_password")
  isTwoFactorEnabled     Boolean   @default(false) @map("is_two_factor_enabled")
  twoFactorSecret        String?   @map("two_factor_secret") @db.VarChar(255)
  twoFactorRecoveryCodes String[]  @default([]) @map("two_factor_recovery_codes")
  twoFactorEnrolledAt    DateTime? @map("two_factor_enrolled_at") @db.Timestamptz
  failedLoginAttempts    Int       @default(0) @map("failed_login_attempts")
  lockedUntil            DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt            DateTime? @map("last_login_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions      Session[]
  refreshTokens RefreshToken[]
  roles         UserRole[]
  branches      UserBranch[]
  employee      Employee?

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Session {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  familyId    String    @map("family_id") @db.Uuid
  userAgent   String?   @map("user_agent") @db.VarChar(512)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz
  stepUpUntil DateTime? @map("step_up_until") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([companyId])
  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @map("token_hash") @db.VarChar(64)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([sessionId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Invitation {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  email       String    @db.VarChar(255)
  tokenHash   String    @map("token_hash") @db.VarChar(64)
  roleId      String?   @map("role_id") @db.VarChar(64)
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId])
  @@index([tokenHash])
  @@index([email])
  @@map("invitations")
}

model PasswordReset {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId])
  @@index([tokenHash])
  @@index([userId])
  @@map("password_resets")
}

// Global System Permission Catalogue (ARCH-GLOBAL-DATA)
model SystemPermission {
  code            String           @id @db.VarChar(64)
  module          String           @db.VarChar(64)
  description     String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  rolePermissions RolePermission[]

  @@map("system_permissions")
}

// Roles, Permissions, UserRoles & UserBranches (Tenant-scoped, RLS enforced)
model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String   @db.VarChar(128)
  code        String   @db.VarChar(64)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(uuid(7)) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  permissionCode String   @map("permission_code") @db.VarChar(64)
  scope          String?  @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  role       Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SystemPermission @relation(fields: [permissionCode], references: [code], onDelete: Cascade)

  @@unique([companyId, roleId, permissionCode])
  @@index([companyId])
  @@index([roleId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, roleId])
  @@index([companyId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model UserBranch {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, branchId])
  @@index([companyId])
  @@index([userId])
  @@index([branchId])
  @@map("user_branches")
}
