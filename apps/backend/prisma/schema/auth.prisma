// Auth and Session models (Task A0.8)

model User {
  id                  String         @default(uuid(7)) @id @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  email               String         @unique @db.VarChar(255)
  passwordHash        String         @map("password_hash") @db.VarChar(255)
  fullName            String         @map("full_name") @db.VarChar(255)
  phone               String?        @db.VarChar(32)
  status              String         @default("ACTIVE") @db.VarChar(32)
  isTwoFactorEnabled  Boolean        @default(false) @map("is_two_factor_enabled")
  twoFactorSecret     String?        @map("two_factor_secret") @db.VarChar(255)
  failedLoginAttempts Int            @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?      @map("locked_until") @db.Timestamptz
  lastLoginAt         DateTime?      @map("last_login_at") @db.Timestamptz
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions            Session[]
  refreshTokens       RefreshToken[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Session {
  id            String         @default(uuid(7)) @id @db.Uuid
  companyId     String         @map("company_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  familyId      String         @map("family_id") @db.Uuid
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  ipAddress     String?        @map("ip_address") @db.VarChar(64)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz
  lastSeenAt    DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz
  stepUpUntil   DateTime?      @map("step_up_until") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([companyId])
  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model RefreshToken {
  id           String    @default(uuid(7)) @id @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @map("token_hash") @db.VarChar(64)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session      Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([sessionId])
  @@index([familyId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Invitation {
  id           String    @default(uuid(7)) @id @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  email        String    @db.VarChar(255)
  tokenHash    String    @map("token_hash") @db.VarChar(64)
  roleId       String?   @map("role_id") @db.VarChar(64)
  invitedById  String?   @map("invited_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt   DateTime? @map("accepted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId])
  @@index([tokenHash])
  @@index([email])
  @@map("invitations")
}

model PasswordReset {
  id        String    @default(uuid(7)) @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([companyId])
  @@index([tokenHash])
  @@index([userId])
  @@map("password_resets")
}
